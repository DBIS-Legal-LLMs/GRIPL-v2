# domain
GRIPL_HOST=example.com

# spring
SPRING_PROFILES_ACTIVE=prod

# traefik
TRAEFIK_NETWORK=web
TRAEFIK_ACME_EMAIL=you@example.com

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super-secret
POSTGRES_DB=gripl_db

# ── auth-service (shared identity provider) ────────────────────────────────
# auth-service issues JWTs; gripl-backend only verifies them against its JWKS
# (RS256 — no shared secret). auth-service is deployed as its own stack and
# must be reachable from gripl-backend at the URL below.
AUTH_SERVICE_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# Base URL of auth-service itself — used both by gripl-frontend to proxy
# /auth/* (login/register) and by gripl-backend to fetch a caller's own
# OpenRouter API key (no shared server-side LLM key; every analysis is billed
# to the calling user's own OpenRouter account).
AUTH_SERVICE_INTERNAL_URL=https://auth.example.com
