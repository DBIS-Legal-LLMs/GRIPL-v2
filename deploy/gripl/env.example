# Copy to .env in the stack directory (never commit it).
# Generate secrets with:  openssl rand -base64 24 | tr -d '/+='

# ---- which environment is this? -------------------------------------------
ENVIRONMENT=prod                      # prod | dev  (decides the Docker network dbis-<env>)
COMPOSE_PROJECT_NAME=gripl-prod       # gripl-prod | gripl-dev  (prefix of containers and volumes)
IMAGE_TAG=prod                        # prod (built from main) | dev (built from dev)
IMAGE_REGISTRY=ghcr.io/dbis-legal-llms

# ---- how users reach it ----------------------------------------------------
# There is no domain yet, so the names come from nip.io, which resolves
# <anything>.134.60.71.167.nip.io to 134.60.71.167 (the certificate from
# deploy/traefik/make-selfsigned-cert.sh covers them).
#   prod: gripl.134.60.71.167.nip.io     dev: gripl-dev.134.60.71.167.nip.io
# With a real domain later: gripl.<domain> / gripl-dev.<domain>.
GRIPL_HOST=gripl.134.60.71.167.nip.io
PUBLIC_SCHEME=https

# Who may reach this environment, as comma-separated CIDRs. The server is on the internet.
#   prod (public):          ALLOWED_CIDRS=0.0.0.0/0,::/0
#   dev (uni network only): ALLOWED_CIDRS=134.60.0.0/16    # confirm the exact ranges with the server admin
ALLOWED_CIDRS=0.0.0.0/0,::/0

# Swagger UI / OpenAPI docs of the backend. Keep false on anything public; true is fine on dev.
API_DOCS_ENABLED=false

# ---- secrets ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gripl_db
NEO4J_PASSWORD=

# ---- optional: memory limits per container (defaults shown) -----------------
#MEM_FRONTEND=768m
#MEM_BACKEND=2g
#MEM_RAG=3g
#MEM_NEO4J=2g
#MEM_POSTGRES=1g
#NEO4J_HEAP=512m
#NEO4J_PAGECACHE=512m
