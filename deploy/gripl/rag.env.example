# Copy to rag.env in the stack directory (never commit it).
# Settings of gripl-rag. The knowledge base is shared infrastructure, so these
# keys are the PROJECT's own OpenRouter account, not a user's.

LLM_BINDING=openai
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
LLM_API_KEY=

EMBEDDING_BINDING=openai
EMBEDDING_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_API_KEY=

RERANK_BINDING=none

RAG_QUERY_TIMEOUT=300
RAGAS_METRIC_TIMEOUT=600
