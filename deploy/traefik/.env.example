# Copy to .env (never commit it). Used by both compose files in this directory.

# Host ports and the address Traefik listens on. Keep the defaults on the server.
# (BIND_ADDRESS stays IPv4 on purpose, see docker-compose.yml.)
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO

# ---- only for docker-compose.https.yml (Let's Encrypt, needs a real domain) ----
# Base domain that the wildcard certificate covers, e.g. gripl.example.org
BASE_DOMAIN=
ACME_EMAIL=
# Staging CA first! Production: https://acme-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DNS_PROVIDER=rfc2136

# Credentials for the DNS provider (names are lego's; these are for rfc2136).
# The TSIG key should only be allowed to change _acme-challenge records.
RFC2136_NAMESERVER=
RFC2136_TSIG_ALGORITHM=hmac-sha256.
RFC2136_TSIG_KEY=
RFC2136_TSIG_SECRET=
